# 让 shell 脚本无论谁在什么系统上 clone 都保持 LF。
# 否则 Windows 上 commit、Linux 容器里执行会炸出 "$'\r': command not found"。
*.sh            text eol=lf
Dockerfile      text eol=lf
docker-entrypoint.sh text eol=lf

*.py            text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.toml          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf

*.bat           text eol=crlf
*.ps1           text eol=crlf

LICENSE         text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.dockerignore   text eol=lf

*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.xlsx          binary
*.db            binary
